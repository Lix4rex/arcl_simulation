<?xml version="1.0" encoding="utf-8"?>
<!--
  Tapis de la table Eurobot pour RViz : un rectangle de 3 m x 2 m qui porte l'image tapis_2027.png.
  Le coin (0, 0) du rectangle est le coin (0, 0) de la table ; X le long des 3 m, Y le long des 2 m.
  L'image doit être dans le même dossier que ce fichier.
-->
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>

  <library_images>
    <image id="tapis_image" name="tapis_image">
      <init_from>tapis_2027.png</init_from>
    </image>
  </library_images>

  <library_effects>
    <effect id="tapis_effect">
      <profile_COMMON>
        <newparam sid="tapis_surface">
          <surface type="2D">
            <init_from>tapis_image</init_from>
          </surface>
        </newparam>
        <newparam sid="tapis_sampler">
          <sampler2D>
            <source>tapis_surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <diffuse>
              <texture texture="tapis_sampler" texcoord="UVSET0"/>
            </diffuse>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>

  <library_materials>
    <material id="tapis_material" name="tapis_material">
      <instance_effect url="#tapis_effect"/>
    </material>
  </library_materials>

  <library_geometries>
    <geometry id="tapis_mesh" name="tapis_mesh">
      <mesh>
        <!-- 4 coins : (0,0) (3,0) (3,2) (0,2) -->
        <source id="tapis_positions">
          <float_array id="tapis_positions_array" count="12">0 0 0  3 0 0  3 2 0  0 2 0</float_array>
          <technique_common>
            <accessor source="#tapis_positions_array" count="4" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <source id="tapis_normals">
          <float_array id="tapis_normals_array" count="3">0 0 1</float_array>
          <technique_common>
            <accessor source="#tapis_normals_array" count="1" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <!-- coordonnées dans l'image : (0,0) = bas gauche de l'image, (1,1) = haut droit -->
        <source id="tapis_uv">
          <float_array id="tapis_uv_array" count="8">0 0  1 0  1 1  0 1</float_array>
          <technique_common>
            <accessor source="#tapis_uv_array" count="4" stride="2">
              <param name="S" type="float"/>
              <param name="T" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="tapis_vertices">
          <input semantic="POSITION" source="#tapis_positions"/>
        </vertices>
        <!-- 2 triangles : (coin, normale, uv) -->
        <triangles material="tapis_material_symbol" count="2">
          <input semantic="VERTEX" source="#tapis_vertices" offset="0"/>
          <input semantic="NORMAL" source="#tapis_normals" offset="1"/>
          <input semantic="TEXCOORD" source="#tapis_uv" offset="2" set="0"/>
          <p>0 0 0  1 0 1  2 0 2   0 0 0  2 0 2  3 0 3</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>

  <library_visual_scenes>
    <visual_scene id="scene">
      <node id="tapis" name="tapis">
        <instance_geometry url="#tapis_mesh">
          <bind_material>
            <technique_common>
              <instance_material symbol="tapis_material_symbol" target="#tapis_material">
                <bind_vertex_input semantic="UVSET0" input_semantic="TEXCOORD" input_set="0"/>
              </instance_material>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>

  <scene>
    <instance_visual_scene url="#scene"/>
  </scene>
</COLLADA>
