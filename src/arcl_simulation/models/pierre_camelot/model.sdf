<?xml version="1.0"?>
<sdf version="1.9">
  <model name="pierre_camelot">
    <!-- Pierre Eurobot 2027 : boîte carton 110 x 110 x 320 mm, grand axe selon z (debout).
         Un autocollant ArUco (DICT_4X4_50, ID 13, tag 70 mm dans un carré blanc de 100 mm, marge 15 mm)
         est collé au centre de chacune des 4 grandes faces. -->
    <link name="link">
      <inertial><mass>0.09</mass><inertia><ixx>8.5875e-04</ixx><ixy>0</ixy><ixz>0</ixz><iyy>8.5875e-04</iyy><iyz>0</iyz><izz>1.8150e-04</izz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.11 0.11 0.32</size></box></geometry><surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface></collision>

      <!-- Carton -->
      <visual name="carton"><geometry><box><size>0.11 0.11 0.32</size></box></geometry>
        <material><ambient>0.75 0.63 0.45 1</ambient><diffuse>0.75 0.63 0.45 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
      </visual>

      <!-- Autocollants ArUco (1 mm d'épaisseur, posés contre chaque grande face) -->
      <visual name="aruco_avant"><pose>0.0555 0 0 0 1.5708 0</pose>
        <geometry><box><size>0.1 0.1 0.001</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
          <pbr><metal><albedo_map>model://pierre_camelot/materials/textures/aruco_4x4_50_id13.png</albedo_map><metalness>0</metalness><roughness>1</roughness></metal></pbr></material>
      </visual>
      <visual name="aruco_arriere"><pose>-0.0555 0 0 0 1.5708 0</pose>
        <geometry><box><size>0.1 0.1 0.001</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
          <pbr><metal><albedo_map>model://pierre_camelot/materials/textures/aruco_4x4_50_id13.png</albedo_map><metalness>0</metalness><roughness>1</roughness></metal></pbr></material>
      </visual>
      <visual name="aruco_gauche"><pose>0 0.0555 0 1.5708 0 0</pose>
        <geometry><box><size>0.1 0.1 0.001</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
          <pbr><metal><albedo_map>model://pierre_camelot/materials/textures/aruco_4x4_50_id13.png</albedo_map><metalness>0</metalness><roughness>1</roughness></metal></pbr></material>
      </visual>
      <visual name="aruco_droite"><pose>0 -0.0555 0 1.5708 0 0</pose>
        <geometry><box><size>0.1 0.1 0.001</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
          <pbr><metal><albedo_map>model://pierre_camelot/materials/textures/aruco_4x4_50_id13.png</albedo_map><metalness>0</metalness><roughness>1</roughness></metal></pbr></material>
      </visual>
    </link>
  </model>
</sdf>
