<?xml version="1.0"?>
<!-- Généré avec le monde SDF : mêmes noms de liens et d'articulations, mêmes cotes. Ne pas éditer à la main. -->
<robot name="robot_omni">
  <material name="gris"><color rgba="0.25 0.3 0.35 1"/></material>
  <material name="anthracite"><color rgba="0.3 0.3 0.3 1"/></material>
  <material name="noir"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="rouge"><color rgba="0.9 0.15 0.15 1"/></material>
  <material name="jaune"><color rgba="0.95 0.75 0.1 1"/></material>
  <material name="bleu_objectif"><color rgba="0.05 0.05 0.2 1"/></material>
  <material name="alu"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="gris_clair"><color rgba="0.7 0.7 0.7 1"/></material>
  <material name="orange"><color rgba="0.9 0.45 0.1 1"/></material>

  <!-- base_link : centre du robot au niveau du sol, x vers l'avant, y vers la gauche -->
  <link name="base_link"/>

  <link name="chassis">
    <visual><geometry><box size="0.2 0.2 0.05"/></geometry><material name="gris"/></visual>
    <visual><origin xyz="0.04 0 0.028"/><geometry><box size="0.04 0.02 0.006"/></geometry><material name="rouge"/></visual>
    <visual><origin xyz="0 0 0.205"/><geometry><cylinder radius="0.01" length="0.36"/></geometry><material name="gris"/></visual>
    <!-- Support caméra (plaque 3 mm) et boîtier posé dessus, au ras du châssis -->
    <visual><origin xyz="0.09 0 0.0265"/><geometry><box size="0.02 0.05 0.003"/></geometry><material name="anthracite"/></visual>
    <visual><origin xyz="0.09 0 0.0405"/><geometry><box size="0.02 0.05 0.025"/></geometry><material name="noir"/></visual>
    <visual><origin xyz="0.105 0 0.0405" rpy="0 1.5708 0"/><geometry><cylinder radius="0.008" length="0.01"/></geometry><material name="bleu_objectif"/></visual>
    <!-- Supports et rails verticaux de l'ascenseur (rails allongés : course 0 à 12 cm) -->
    <visual><origin xyz="0.09 0.045 0.0265"/><geometry><box size="0.02 0.03 0.003"/></geometry><material name="anthracite"/></visual>
    <visual><origin xyz="0.078 0.045 0.144"/><geometry><box size="0.004 0.012 0.232"/></geometry><material name="alu"/></visual>
    <visual><origin xyz="0.09 -0.045 0.0265"/><geometry><box size="0.02 0.03 0.003"/></geometry><material name="anthracite"/></visual>
    <visual><origin xyz="0.078 -0.045 0.144"/><geometry><box size="0.004 0.012 0.232"/></geometry><material name="alu"/></visual>
    <collision><geometry><box size="0.2 0.2 0.05"/></geometry></collision>
    <collision><origin xyz="0.09 0 0.039"/><geometry><box size="0.02 0.05 0.028"/></geometry></collision>
    <inertial><mass value="3"/><inertia ixx="0.010625" ixy="0" ixz="0" iyy="0.010625" iyz="0" izz="0.02"/></inertial>
  </link>
  <joint name="chassis_joint" type="fixed"><parent link="base_link"/><child link="chassis"/><origin xyz="0 0 0.045"/></joint>

  <!-- Ascenseur : chariot sur les rails + servo du poignet (repère = repère du châssis) -->
  <link name="ascenseur">
    <visual><origin xyz="0.078 0.045 0.121"/><geometry><box size="0.008 0.016 0.02"/></geometry><material name="noir"/></visual>
    <visual><origin xyz="0.078 -0.045 0.121"/><geometry><box size="0.008 0.016 0.02"/></geometry><material name="noir"/></visual>
    <visual><origin xyz="0.083 0 0.121"/><geometry><box size="0.006 0.1 0.014"/></geometry><material name="anthracite"/></visual>
    <visual><origin xyz="0.092 0 0.121"/><geometry><box size="0.014 0.04 0.022"/></geometry><material name="noir"/></visual>
    <inertial><origin xyz="0.088 0 0.121"/><mass value="0.2"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="ascenseur_joint" type="prismatic"><parent link="chassis"/><child link="ascenseur"/><origin xyz="0 0 0"/><axis xyz="0 0 1"/><limit lower="0" upper="0.12" effort="50" velocity="0.1"/></joint>

  <!-- Poignet : plaque à 3 paires de ventouses (une par carton), tournée de 0 à 90° autour de l'axe avant du robot.
       Origine du lien = axe de rotation, au centre du carton du milieu (16.6 cm du sol, ascenseur en bas). -->
  <link name="poignet">
    <visual><origin xyz="-0.005 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.012" length="0.004"/></geometry><material name="gris_clair"/></visual>
    <visual><origin xyz="0 0 0"/><geometry><box size="0.008 0.14 0.012"/></geometry><material name="anthracite"/></visual>
    <visual><origin xyz="0 0.06 0"/><geometry><box size="0.008 0.008 0.25"/></geometry><material name="anthracite"/></visual>
    <visual><origin xyz="0 -0.06 0"/><geometry><box size="0.008 0.008 0.25"/></geometry><material name="anthracite"/></visual>
    <!-- Étage 1 : ventouse_1_g / ventouse_1_d -->
    <visual><origin xyz="0.012 0.06 -0.111"/><geometry><box size="0.016 0.02 0.02"/></geometry><material name="noir"/></visual>
    <visual><origin xyz="0.028 0.06 -0.111" rpy="0 1.5708 0"/><geometry><cylinder radius="0.005" length="0.016"/></geometry><material name="gris_clair"/></visual>
    <visual><origin xyz="0.041 0.06 -0.111" rpy="0 1.5708 0"/><geometry><cylinder radius="0.015" length="0.01"/></geometry><material name="orange"/></visual>
    <visual><origin xyz="0.012 -0.06 -0.111"/><geometry><box size="0.016 0.02 0.02"/></geometry><material name="noir"/></visual>
    <visual><origin xyz="0.028 -0.06 -0.111" rpy="0 1.5708 0"/><geometry><cylinder radius="0.005" length="0.016"/></geometry><material name="gris_clair"/></visual>
    <visual><origin xyz="0.041 -0.06 -0.111" rpy="0 1.5708 0"/><geometry><cylinder radius="0.015" length="0.01"/></geometry><material name="orange"/></visual>
    <!-- Étage 2 : ventouse_2_g / ventouse_2_d -->
    <visual><origin xyz="0.012 0.06 0"/><geometry><box size="0.016 0.02 0.02"/></geometry><material name="noir"/></visual>
    <visual><origin xyz="0.028 0.06 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.005" length="0.016"/></geometry><material name="gris_clair"/></visual>
    <visual><origin xyz="0.041 0.06 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.015" length="0.01"/></geometry><material name="orange"/></visual>
    <visual><origin xyz="0.012 -0.06 0"/><geometry><box size="0.016 0.02 0.02"/></geometry><material name="noir"/></visual>
    <visual><origin xyz="0.028 -0.06 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.005" length="0.016"/></geometry><material name="gris_clair"/></visual>
    <visual><origin xyz="0.041 -0.06 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.015" length="0.01"/></geometry><material name="orange"/></visual>
    <!-- Étage 3 : ventouse_3_g / ventouse_3_d -->
    <visual><origin xyz="0.012 0.06 0.111"/><geometry><box size="0.016 0.02 0.02"/></geometry><material name="noir"/></visual>
    <visual><origin xyz="0.028 0.06 0.111" rpy="0 1.5708 0"/><geometry><cylinder radius="0.005" length="0.016"/></geometry><material name="gris_clair"/></visual>
    <visual><origin xyz="0.041 0.06 0.111" rpy="0 1.5708 0"/><geometry><cylinder radius="0.015" length="0.01"/></geometry><material name="orange"/></visual>
    <visual><origin xyz="0.012 -0.06 0.111"/><geometry><box size="0.016 0.02 0.02"/></geometry><material name="noir"/></visual>
    <visual><origin xyz="0.028 -0.06 0.111" rpy="0 1.5708 0"/><geometry><cylinder radius="0.005" length="0.016"/></geometry><material name="gris_clair"/></visual>
    <visual><origin xyz="0.041 -0.06 0.111" rpy="0 1.5708 0"/><geometry><cylinder radius="0.015" length="0.01"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0.041 0.06 -0.111" rpy="0 1.5708 0"/><geometry><cylinder radius="0.015" length="0.01"/></geometry></collision>
    <collision><origin xyz="0.041 -0.06 -0.111" rpy="0 1.5708 0"/><geometry><cylinder radius="0.015" length="0.01"/></geometry></collision>
    <collision><origin xyz="0.041 0.06 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.015" length="0.01"/></geometry></collision>
    <collision><origin xyz="0.041 -0.06 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.015" length="0.01"/></geometry></collision>
    <collision><origin xyz="0.041 0.06 0.111" rpy="0 1.5708 0"/><geometry><cylinder radius="0.015" length="0.01"/></geometry></collision>
    <collision><origin xyz="0.041 -0.06 0.111" rpy="0 1.5708 0"/><geometry><cylinder radius="0.015" length="0.01"/></geometry></collision>
    <inertial><origin xyz="0.024 0 0"/><mass value="0.15"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="poignet_joint" type="revolute"><parent link="ascenseur"/><child link="poignet"/><origin xyz="0.106 0 0.121"/><axis xyz="1 0 0"/><limit lower="0" upper="1.5708" effort="5" velocity="2"/></joint>

  <link name="roue_1"><visual><geometry><cylinder radius="0.03" length="0.025"/></geometry><material name="noir"/></visual><visual><geometry><box size="0.048 0.008 0.02625"/></geometry><material name="jaune"/></visual><collision><geometry><cylinder radius="0.03" length="0.025"/></geometry></collision><inertial><mass value="0.1"/><inertia ixx="2.77083e-05" ixy="0" ixz="0" iyy="2.77083e-05" iyz="0" izz="4.5e-05"/></inertial></link>
  <joint name="roue_1_joint" type="continuous"><parent link="base_link"/><child link="roue_1"/><origin xyz="0.115 0.115 0.03" rpy="0 1.5708 0.785398"/><axis xyz="0 0 -1"/></joint>

  <link name="roue_2"><visual><geometry><cylinder radius="0.03" length="0.025"/></geometry><material name="noir"/></visual><visual><geometry><box size="0.048 0.008 0.02625"/></geometry><material name="jaune"/></visual><collision><geometry><cylinder radius="0.03" length="0.025"/></geometry></collision><inertial><mass value="0.1"/><inertia ixx="2.77083e-05" ixy="0" ixz="0" iyy="2.77083e-05" iyz="0" izz="4.5e-05"/></inertial></link>
  <joint name="roue_2_joint" type="continuous"><parent link="base_link"/><child link="roue_2"/><origin xyz="-0.115 0.115 0.03" rpy="0 1.5708 2.35619"/><axis xyz="0 0 -1"/></joint>

  <link name="roue_3"><visual><geometry><cylinder radius="0.03" length="0.025"/></geometry><material name="noir"/></visual><visual><geometry><box size="0.048 0.008 0.02625"/></geometry><material name="jaune"/></visual><collision><geometry><cylinder radius="0.03" length="0.025"/></geometry></collision><inertial><mass value="0.1"/><inertia ixx="2.77083e-05" ixy="0" ixz="0" iyy="2.77083e-05" iyz="0" izz="4.5e-05"/></inertial></link>
  <joint name="roue_3_joint" type="continuous"><parent link="base_link"/><child link="roue_3"/><origin xyz="-0.115 -0.115 0.03" rpy="0 1.5708 3.92699"/><axis xyz="0 0 -1"/></joint>

  <link name="roue_4"><visual><geometry><cylinder radius="0.03" length="0.025"/></geometry><material name="noir"/></visual><visual><geometry><box size="0.048 0.008 0.02625"/></geometry><material name="jaune"/></visual><collision><geometry><cylinder radius="0.03" length="0.025"/></geometry></collision><inertial><mass value="0.1"/><inertia ixx="2.77083e-05" ixy="0" ixz="0" iyy="2.77083e-05" iyz="0" izz="4.5e-05"/></inertial></link>
  <joint name="roue_4_joint" type="continuous"><parent link="base_link"/><child link="roue_4"/><origin xyz="0.115 -0.115 0.03" rpy="0 1.5708 5.49779"/><axis xyz="0 0 -1"/></joint>

  <link name="lidar"><visual><geometry><cylinder radius="0.035" length="0.04"/></geometry><material name="noir"/></visual></link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar"/><origin xyz="0 0 0.43"/></joint>

  <link name="imu"/>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu"/><origin xyz="0 0 0.045"/></joint>

  <link name="camera"/>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera"/><origin xyz="0.11 0 0.0855" rpy="0 0 0"/></joint>

  <link name="camera_optical"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera"/><child link="camera_optical"/><origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/></joint>

</robot>